;; BricsCAD-authored synthetic masters: tables, regions and solids. All values invented.
;; Run through generators/run_bricscad.py, which sets *out-dir* (absolute, trailing slash) and *topic* before loading.
;; No external drawing inputs. Each topic is built in a fresh BricsCAD session, then saved at every format and
;; version BricsCAD can write: ASCII DXF R12 to 2018, binary DXF R12 to 2018 (DXFOUT command), DWG 2000 to 2018.
(vl-load-com)
(if (not *out-dir*) (setq *out-dir* "native/bricscad/"))
(defun mk-log (s / f) (setq f (open (strcat *out-dir* "make_bricscad_masters.log") "a")) (write-line s f) (close f))
(defun mk-lay (doc n) (vl-catch-all-apply 'vla-Add (list (vla-get-Layers doc) n)))
(defun mk-try (label fn / r)
  (setq r (vl-catch-all-apply fn nil))
  (mk-log (strcat label ": " (if (vl-catch-all-error-p r) (strcat "ERROR " (vl-catch-all-error-message r)) "ok")))
  (if (vl-catch-all-error-p r) nil r))
(defun mk-arr (objs / a) (setq a (vlax-make-safearray vlax-vbObject (cons 0 (1- (length objs))))) (vlax-safearray-fill a objs) a)
;; Identity carried as ZEV_IDENTITY extended data on the model-space block, as in the other native drawings.
(defun mk-identity (doc intent / ent)
  (mk-try "RegApp" (function (lambda () (regapp "ZEV_IDENTITY"))))
  (mk-try "entmod identity" (function (lambda ()
    (setq ent (entget (tblobjname "BLOCK" "*Model_Space") '("ZEV_IDENTITY")))
    (mk-log (strcat "block entity: " (vl-princ-to-string ent)))
    (entmod (append ent (list (list -3 (list "ZEV_IDENTITY" (cons 1000 intent) (cons 1000 "reference_1")))))))))
  (mk-try "readback identity" (function (lambda () (mk-log (vl-princ-to-string (entget (tblobjname "BLOCK" "*Model_Space") '("ZEV_IDENTITY"))))))))
(defun mk-tables (doc ms / t1 t2)
  (foreach n '("F150_table_merged_title" "F151_table_plain") (mk-lay doc n))
  (setq t1 (mk-try "AddTable merged" (function (lambda () (vla-AddTable ms (vlax-3d-point 0.0 0.0 0.0) 4 3 8.0 30.0)))))
  (if t1 (progn
    (vla-put-Layer t1 "F150_table_merged_title")
    (mk-try "SetText title" (function (lambda () (vla-SetText t1 0 0 "Merged Title Row"))))
    (mk-try "SetText cells" (function (lambda ()
      (vla-SetText t1 1 0 "Item") (vla-SetText t1 1 1 "Qty") (vla-SetText t1 1 2 "Note")
      (vla-SetText t1 2 0 "Widget") (vla-SetText t1 2 1 "12") (vla-SetText t1 2 2 "red")
      (vla-SetText t1 3 0 "Gadget") (vla-SetText t1 3 1 "7") (vla-SetText t1 3 2 "blue"))))))
  (setq t2 (mk-try "AddTable plain" (function (lambda () (vla-AddTable ms (vlax-3d-point 120.0 0.0 0.0) 3 2 8.0 25.0)))))
  (if t2 (progn
    (vla-put-Layer t2 "F151_table_plain")
;; the default table style makes row 0 a title row (merged) and row 1 a header row; the plain table must have neither
    (mk-try "plain: no title row" (function (lambda () (vla-put-TitleSuppressed t2 :vlax-true))))
    (mk-try "plain: no header row" (function (lambda () (vla-put-HeaderSuppressed t2 :vlax-true))))
    (mk-try "SetText plain" (function (lambda ()
      (vla-SetText t2 0 0 "A1") (vla-SetText t2 0 1 "B1") (vla-SetText t2 1 0 "A2") (vla-SetText t2 1 1 "B2") (vla-SetText t2 2 0 "A3") (vla-SetText t2 2 1 "B3"))))
;; with the title and header suppressed changed nothing): the anonymous block drawn for this table never shows the B1
;; text although the table's cell data holds it. The intent therefore expects cell data, not the drawn block.
    )))
(defun mk-acis (doc ms / c reg box)
  (foreach n '("F152_region" "F154_solid3d") (mk-lay doc n))
  (setq c (vla-AddCircle ms (vlax-3d-point 0.0 0.0 0.0) 10.0))
  (vla-put-Layer c "F152_region")
  (setq reg (mk-try "AddRegion" (function (lambda () (vla-AddRegion ms (mk-arr (list c)))))))
  (if reg (foreach rg (vlax-safearray->list (vlax-variant-value reg)) (vla-put-Layer rg "F152_region")))
  (vla-Delete c)
  (setq box (mk-try "AddBox" (function (lambda () (vla-AddBox ms (vlax-3d-point 80.0 0.0 0.0) 12.0 8.0 6.0)))))
  (if box (vla-put-Layer box "F154_solid3d")))
(defun mk-save-all (doc topic / v r p)
  (foreach v '("2018" "2013" "2010" "2007" "2004" "2000" "R12")
    (setq p (strcat *out-dir* topic "_" v "_ASCII.dxf"))
    (setq r (vl-catch-all-apply 'vla-SaveAs (list doc p (cdr (assoc v '(("2018" . 65) ("2013" . 61) ("2010" . 49) ("2007" . 37) ("2004" . 25) ("2000" . 13) ("R12" . 1)))))))
    (mk-log (strcat "save " p ": " (if (vl-catch-all-error-p r) (vl-catch-all-error-message r) "ok")))
    (setq p (strcat *out-dir* topic "_" v "_binary.dxf"))
    (setq r (vl-catch-all-apply (function (lambda () (command "_.DXFOUT" p "_V" v "_B"))) nil))
    (mk-log (strcat "save " p ": " (if (vl-catch-all-error-p r) (vl-catch-all-error-message r) "ok")))
    (if (/= v "R12")
      (progn
        (setq p (strcat *out-dir* topic "_" v "_binary.dwg"))
        (setq r (vl-catch-all-apply 'vla-SaveAs (list doc p (cdr (assoc v '(("2018" . 64) ("2013" . 60) ("2010" . 48) ("2007" . 36) ("2004" . 24) ("2000" . 12)))))))
        (mk-log (strcat "save " p ": " (if (vl-catch-all-error-p r) (vl-catch-all-error-message r) "ok")))))))
(defun mk-run (/ doc ms)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) ms (vla-get-ModelSpace doc))
  (cond
    ((= *topic* "k_tables") (mk-tables doc ms) (mk-identity doc "future_k_tables") (mk-save-all doc "k_tables"))
    ((= *topic* "k_regions_solids") (mk-acis doc ms) (mk-identity doc "future_k_regions_solids") (mk-save-all doc "k_regions_solids")))
  (princ))
